[Unit]
Description=NavPlotter node
After=network-online.target
Wants=network-online.target

[Service]
User=navplotter
Group=navplotter
WorkingDirectory=/opt/navplotter
ExecStart=/usr/bin/python3 -m navplotter --settings /var/lib/navplotter/settings.json
Restart=always
RestartSec=5
# The web app is on port 80, as on the other nodes
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
